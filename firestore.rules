rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  // Canonical server-managed role. No client may create/change/delete roles.
  function admin() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
  function owner(uid) { return signedIn() && request.auth.uid == uid && (request.auth.token.email_verified == true || admin()); }
  function text(d,k,max) { return d.get(k,null) == null || (d[k] is string && d[k].size() <= max); }
  function bool(d,k) { return d.get(k,null) == null || d[k] is bool; }
  function money(d,k) { return d.get(k,null) == null || (d[k] is number && d[k] >= 0 && d[k] <= 1000000000); }
  function url(d,k) { return d.get(k,null) == null || d[k] == '' || (d[k] is string && d[k].size() <= 2048 && d[k].matches('^https://[^\\s]+$')); }
  function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
  match /users/{uid} {
   // Unverified users need their own profile for login/verification.
   allow read: if (signedIn() && request.auth.uid == uid) || admin();
   allow create, delete: if false;
   allow update: if ((signedIn() && request.auth.uid == uid) || admin()) && changedOnly(['full_name','phone','updated_at']) && text(request.resource.data,'full_name',100) && text(request.resource.data,'phone',20) && request.resource.data.updated_at == request.time;
  }
  match /products/{id} {
   allow read: if resource.data.is_active == true || admin();
   allow create, delete: if false;
   // Preserve admin legacy-brand linking only; all content/price/stock mutations use server APIs.
   allow update: if admin() && changedOnly(['brand','brand_id','updated_at']) && text(request.resource.data,'brand',200) && text(request.resource.data,'brand_id',200) && request.resource.data.updated_at == request.time;
  }
  match /orders/{id} {
   allow read: if admin() || owner(resource.data.user_id);
   allow create, delete: if false;
   // Preserve notification acknowledgement, never direct state/payment edits.
   allow update: if admin() && changedOnly(['is_read']) && request.resource.data.is_read is bool;
   match /items/{item} {
    allow read: if admin() || owner(get(/databases/$(database)/documents/orders/$(id)).data.user_id);
    allow write: if false;
   }
  }
  match /payments/{id} { allow read: if admin(); allow write: if false; }
  match /payment_uploads/{id} { allow read, write: if false; }
  match /order_requests/{id} { allow read, write: if false; }
  match /email_deliveries/{id} { allow read, write: if false; }
  match /audit_logs/{id} { allow read: if admin(); allow write: if false; }
  match /messages/{id} {
   allow read: if admin(); allow create, delete: if false;
   allow update: if admin() && changedOnly(['status']) && request.resource.data.status in ['unread','read','replied'];
  }
  match /newsletter_subscribers/{id} { allow read: if admin(); allow write: if false; }
  match /testimonials/{id} {
   allow read: if resource.data.is_active == true || admin();
   // Server-only submission ensures Turnstile, size limits and moderation.
   allow create, delete: if false;
   allow update: if admin() && changedOnly(['name','role','comment','rating','avatar_url','is_active']) && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100 && text(request.resource.data,'role',100) && text(request.resource.data,'comment',1000) && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 && request.resource.data.is_active is bool && url(request.resource.data,'avatar_url');
  }
  match /brands/{id} {
   allow read: if resource.data.is_active == true || admin(); allow delete: if false;
   allow create, update: if admin() && (request.method == 'create' ? request.resource.data.keys().hasOnly(['name','slug','description','is_active','created_at','updated_at']) : changedOnly(['name','slug','description','is_active','updated_at'])) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200 && text(request.resource.data,'slug',200) && text(request.resource.data,'description',5000) && request.resource.data.is_active is bool && request.resource.data.updated_at == request.time;
  }
  match /promotions/{id} { allow read: if resource.data.is_active == true || admin(); allow write: if false; }
  match /product_promotions/{id} { allow read: if resource.data.is_active == true || admin(); allow write: if false; }
  match /admin_notifications/{id} {
   allow read: if admin(); allow create, delete: if false;
   allow update: if admin() && changedOnly(['is_read']) && request.resource.data.is_read is bool;
  }
  match /website_settings/{id} {
   // Intentionally public business/storefront content; never put secrets or private records here.
   allow read: if true; allow delete: if false;
   allow create, update: if admin() && request.resource.data.keys().hasOnly(['website_name','tagline','description','address','phone','email','opening_hours','facebook_url','instagram_url','tiktok_url','viber_phone','whatsapp_phone','delivery_note','footer_text','about_text','created_at','updated_at'])
    && text(request.resource.data,'website_name',200) && text(request.resource.data,'tagline',500) && text(request.resource.data,'description',5000) && text(request.resource.data,'address',1000) && text(request.resource.data,'phone',30) && text(request.resource.data,'email',254) && text(request.resource.data,'opening_hours',500) && text(request.resource.data,'viber_phone',30) && text(request.resource.data,'whatsapp_phone',30) && text(request.resource.data,'delivery_note',2000) && text(request.resource.data,'footer_text',2000) && text(request.resource.data,'about_text',10000)
    && url(request.resource.data,'facebook_url') && url(request.resource.data,'instagram_url') && url(request.resource.data,'tiktok_url') && request.resource.data.updated_at == request.time;
  }
  match /site_settings/{id} {
   // Merchant payment instructions are public; customer payments are in private collections.
   allow read: if id == '1'; allow delete: if false;
   allow create, update: if id == '1' && admin() && request.resource.data.keys().hasOnly(['store_name','store_tagline','store_email','store_phone','store_address','city','country','enable_checkout','allow_cash_on_delivery','allow_kbzpay','allow_wavepay','allow_ayapay','allow_bank_transfer','free_delivery_enabled','delivery_fee','minimum_order_amount','kbzpay_account_name','kbzpay_phone','wavepay_account_name','wavepay_phone','ayapay_account_name','ayapay_phone','bank_name','bank_account_name','bank_account_number','announcement_enabled','announcement_text','announcement_type','facebook_url','instagram_url','tiktok_url','messenger_url','order_auto_confirm','low_stock_threshold','maintenance_mode','maintenance_message','created_at','updated_at'])
    && text(request.resource.data,'store_name',200) && text(request.resource.data,'store_tagline',500) && text(request.resource.data,'store_email',254) && text(request.resource.data,'store_phone',30) && text(request.resource.data,'store_address',1000) && text(request.resource.data,'city',100) && text(request.resource.data,'country',100)
    && text(request.resource.data,'kbzpay_account_name',200) && text(request.resource.data,'kbzpay_phone',30) && text(request.resource.data,'wavepay_account_name',200) && text(request.resource.data,'wavepay_phone',30) && text(request.resource.data,'ayapay_account_name',200) && text(request.resource.data,'ayapay_phone',30) && text(request.resource.data,'bank_name',200) && text(request.resource.data,'bank_account_name',200) && text(request.resource.data,'bank_account_number',100) && text(request.resource.data,'announcement_text',2000) && text(request.resource.data,'maintenance_message',2000)
    && request.resource.data.get('announcement_type','info') in ['info','success','warning','promo']
    && bool(request.resource.data,'enable_checkout') && bool(request.resource.data,'allow_cash_on_delivery') && bool(request.resource.data,'allow_kbzpay') && bool(request.resource.data,'allow_wavepay') && bool(request.resource.data,'allow_ayapay') && bool(request.resource.data,'allow_bank_transfer') && bool(request.resource.data,'free_delivery_enabled') && bool(request.resource.data,'announcement_enabled') && bool(request.resource.data,'order_auto_confirm') && bool(request.resource.data,'maintenance_mode')
    && money(request.resource.data,'delivery_fee') && money(request.resource.data,'minimum_order_amount') && money(request.resource.data,'low_stock_threshold')
    && url(request.resource.data,'facebook_url') && url(request.resource.data,'instagram_url') && url(request.resource.data,'tiktok_url') && url(request.resource.data,'messenger_url') && request.resource.data.updated_at == request.time;
  }
  // Unlisted collections/subcollections: deny by default.
  match /{document=**} { allow read, write: if false; }
 }
}

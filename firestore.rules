rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.role == "customer";

      allow read: if isOwner(userId) || isAdmin();

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.role == resource.data.role
        );

      allow delete: if isAdmin();
    }

    match /products/{productId} {
      // Public can only read active products
      allow read: if resource.data.is_active == true;
      // Admin can read all products (including inactive)
      allow read: if isAdmin();
      // Only admin can write
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      /*
       * Orders are created ONLY by the authenticated server route
       * /api/checkout/place-order (Firebase Admin SDK), which recomputes every
       * price, subtotal, delivery fee, discount, total and payment status from
       * trusted Firestore product records. Direct client-side creation is
       * DENIED so a malicious client cannot forge orders with arbitrary prices,
       * totals, stock or a "Paid" payment status.
       */
      allow create: if false;

      allow read: if isAdmin()
        || (
          isSignedIn()
          && resource.data.user_id == request.auth.uid
        );

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    match /orders/{orderId}/items/{itemId} {
      allow read: if isAdmin()
        || (
          isSignedIn()
          && get(/databases/$(database)/documents/orders/$(orderId)).data.user_id == request.auth.uid
        );

      allow write: if isAdmin();
    }

    match /messages/{messageId} {
      /*
       * Contact messages are created ONLY by the /api/contact server route
       * (Firebase Admin SDK), after Turnstile + input validation. Direct
       * client writes are DENIED to prevent spam / forged submissions.
       */
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if resource.data.is_active == true || isAdmin();

      /*
       * Testimonials may only be created through /api/testimonials (server),
       * which always sets is_active = false so every submission passes through
       * admin moderation. A client submitting directly can no longer mark its
       * own testimonial as active (which would publish it without approval).
       */
      allow create: if isSignedIn()
        && request.resource.data.is_active == false;

      allow update, delete: if isAdmin();
    }

    match /brands/{brandId} {
      // Public can only read active brands
      allow read: if resource.data.is_active == true;
      // Admin can read all brands
      allow read: if isAdmin();
      // Only admin can write
      allow write: if isAdmin();
    }

    match /website_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /newsletter_subscribers/{email} {
      /*
       * Subscriptions are created ONLY by /api/newsletter (server) after rate
       * limiting + Turnstile. Direct client writes are DENIED to prevent spam
       * and arbitrary subscription manipulation.
       */
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /admin_notifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
